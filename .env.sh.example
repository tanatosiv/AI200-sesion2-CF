# Copiar a .env.sh; editar los valores según la suscripción.
export LOCATION="eastus2"
export SUFFIX="reemplazar"
export RG="rg-ai200-labs-${SUFFIX}"
export ACR="ai200c2${SUFFIX}"
export PLAN="plan-ai200-c2-${SUFFIX}"
export WEBAPP="ai200-c2-web-${SUFFIX}"
export ACA_ENV="env-ai200-c2-${SUFFIX}"
export ACA_WEB="aca-ai200-chat-${SUFFIX}"
export ACA_WORKER="aca-ai200-worker-${SUFFIX}"
export UAI="id-ai200-c2-${SUFFIX}"
export SB_NAMESPACE="sb-ai200-c2-${SUFFIX}"

# URL COMPLETA de la API v1; normalmente https://<recurso>.openai.azure.com/openai/v1/
export FOUNDRY_OPENAI_BASE_URL="https://REEMPLAZAR.openai.azure.com/openai/v1/"

# Nombre del deployment de modelo 
export FOUNDRY_MODEL_DEPLOYMENT="REEMPLAZAR_DEPLOYMENT"

# Resource ID del recurso que sirve el modelo (az resource show ... --query id).
export FOUNDRY_RESOURCE_ID="/subscriptions/REEMPLAZAR/resourceGroups/REEMPLAZAR/providers/Microsoft.CognitiveServices/accounts/REEMPLAZAR"
